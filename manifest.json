{
  "manifest_version": 3,
  "name": "WatToDue - Waterloo LEARN Dues & Grades",
  "version": "1.0.1",
  "description": "Consolidated calendar for assignments, quizzes, and grades on Waterloo LEARN.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://learn.uwaterloo.ca/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WatToDue"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
